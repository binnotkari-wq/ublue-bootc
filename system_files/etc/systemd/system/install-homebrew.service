# Premier boot : Le système démarre, attend le réseau (network-online.target), constate que Brew n'est pas présent,
# et lance le script en tâche d'arrière-plan silencieuse sous root. Brew s'installe dans /home/linuxbrew/.linuxbrew.
# Redémarrages suivants : La condition ConditionPathExists=!/home/linuxbrew/.linuxbrew/bin/brew vaut Faux.
# Systemd saute immédiatement le service (durée : 0 milliseconde).

[Unit]
Description=Automated Non-Interactive Homebrew Installation
After=network-online.target
Wants=network-online.target
# Idempotence : Ne s'exécute PAS si le binaire brew existe déjà
ConditionPathExists=!/home/linuxbrew/.linuxbrew/bin/brew

[Service]
Type=oneshot
RemainAfterExit=yes

# 1. Installation silencieuse via le script officiel
# Variable officielle de Brew pour supprimer les demandes interactives
Environment=NONINTERACTIVE=1
ExecStart=/usr/bin/bash -c '$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)'

# 2. Attribution des droits à l'utilisateur UID 1000 (utilisateur par défaut sous Fedora/Silverblue/bootc)
ExecStartPost=/usr/bin/chown -R 1000:1000 /home/linuxbrew

# Gestion des erreurs réseau : retente toutes les 30s jusqu'à réussite si pas de réseau au boot
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
